{
  "name": "zeeke/regen-resume-builder",
  "description": "ReGen resume management, powered by Zeeke - PHP runtime",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "dompdf/dompdf": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "ReGen\\": "php/src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
