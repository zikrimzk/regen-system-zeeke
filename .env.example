# APPLICATION
APP_ENV=production
APP_URL=https://your-domain.example
TRUST_PROXY=false

# HITPAY HOSTED CHECKOUT
HITPAY_MODE=disabled
HITPAY_API_KEY=
HITPAY_SANDBOX_WEBHOOK_SALT=
HITPAY_LIVE_WEBHOOK_SALT=

# DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=""

# SESSIONS
SESSION_NAME=regen_sid
SESSION_DRIVER=database
SESSION_TTL=86400
SESSION_IDLE_TTL=7200

# LIVE UPDATES (managed push with nonblocking recovery)
REALTIME_TRANSPORT=auto
# auto: managed private-channel push when configured; short adaptive checks otherwise.
# poll: short checks only. PHP-held SSE connections are no longer supported.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# AUTHENTICATION
GOOGLE_CLIENT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# EMAIL (LARAVEL-STYLE SMTP)
# Use the outgoing server shown for your DirectAdmin email account.
# 465 uses ssl; 587 uses tls. Username is the full mailbox address.
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.example
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.example
MAIL_PASSWORD=""
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="ReGen"
# Optional: MAIL_REPLY_TO, MAIL_TIMEOUT (15), EMAIL_VERIFICATION_TTL (3600).

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DAILY_LIMIT=10
OPENAI_SUGGEST_USER_MINUTE_LIMIT=8
OPENAI_SUGGEST_IP_MINUTE_LIMIT=24

# Mochi uses the existing OPENAI_API_KEY and its own model.
MOCHI_AI_ENABLED=true
MOCHI_OPENAI_MODEL=gpt-6-luna

# LOOKUPS
LOOKUP_USER_AGENT="ReGenByZeeke/1.0 (institution lookup)"
